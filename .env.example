# Mission LiFE Gujarat — Environment Configuration
# Operating Mode: 'demo' (offline with localStorage persistence) or 'firebase' (if configured)
VITE_STORAGE_MODE=demo

# Optional Firebase Configuration (for cloud sync mode)
# Leave empty to run in secure offline local demonstration mode
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Application Metadata
VITE_APP_TITLE=Mission LiFE Gujarat
VITE_APP_VERSION=1.0.0
VITE_APP_ORG=Gujarat Energy Development Agency (GEDA)
